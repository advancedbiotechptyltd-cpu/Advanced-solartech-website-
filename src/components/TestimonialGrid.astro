---
/**
 * TestimonialGrid — the business's real Google reviews, shown verbatim.
 *
 * The quotes come from src/data/testimonials.json, which is generated by
 * scripts/fetch-google-reviews.mjs. Nothing here is hand-written, and
 * `getTestimonials()` returns an empty array if the file is ever marked
 * placeholder again — so sample quotes cannot be published by accident.
 * Publishing invented reviews is a misrepresentation under the Australian
 * Consumer Law, so that guard is deliberate rather than defensive.
 *
 * If there are no reviews to show, the section still renders the rating and a
 * link out to the profile: a visitor who came looking for reviews gets
 * somewhere to go rather than a gap where a section used to be.
 */
import { getTestimonials, getReviewProfile } from "../lib/site.js";
import SectionHeader from "./SectionHeader.astro";
import Icon from "./Icon.astro";

const {
  items = getTestimonials(),
  profile = getReviewProfile(),
  heading = "What our customers say",
  kicker = "Reviews",
} = Astro.props;

/*
 * Whole and half stars, always totalling five. Rounding to the nearest half
 * keeps the graphic honest at the granularity a star can express, and the exact
 * figure is printed beside it either way.
 */
function starParts(value) {
  const rounded = Math.round(value * 2) / 2;
  const full = Math.floor(rounded);
  const half = rounded % 1 !== 0;
  return { full, half, empty: 5 - full - (half ? 1 : 0) };
}

const dateFormat = new Intl.DateTimeFormat("en-AU", { month: "short", year: "numeric" });
const showDate = (iso) => {
  const d = new Date(iso);
  return Number.isNaN(d.getTime()) ? "" : dateFormat.format(d);
};
---

{
  (items.length > 0 || profile) && (
    <section class="section section--surface" data-reveal>
      <div class="container">
        <SectionHeader kicker={kicker} heading={heading} align="center" />

        {profile && (() => {
          const stars = starParts(profile.rating);
          return (
          <p class="reviewSummary">
            <span class="reviewSummary__score">{profile.rating.toFixed(1)}</span>
            <span class="stars" role="img" aria-label={`${profile.rating} out of 5 stars`}>
              {Array.from({ length: stars.full }).map(() => (
                <span class="stars__s stars__s--full" aria-hidden="true">★</span>
              ))}
              {stars.half && <span class="stars__s stars__s--half" aria-hidden="true">★</span>}
              {Array.from({ length: Math.max(0, stars.empty) }).map(() => (
                <span class="stars__s" aria-hidden="true">★</span>
              ))}
            </span>
            <span class="reviewSummary__count">
              from {profile.reviewCount} Google reviews
            </span>
          </p>
          );
        })()}

        {items.length > 0 && (
          <ul class="quotes" role="list">
            {items.map((t) => (
              <li class="quotes__item">
                {t.rating && (
                  <span class="stars stars--sm" role="img" aria-label={`${t.rating} out of 5 stars`}>
                    {Array.from({ length: 5 }).map((_, i) => (
                      <span class:list={["stars__s", i < t.rating && "stars__s--full"]} aria-hidden="true">
                        ★
                      </span>
                    ))}
                  </span>
                )}
                <blockquote class="quotes__quote">
                  <p>{t.quote}</p>
                </blockquote>
                <figcaption class="quotes__meta">
                  <span class="quotes__author">{t.author}</span>
                  {t.date && <span class="quotes__location">{showDate(t.date)}</span>}
                  {t.location && <span class="quotes__location">{t.location}</span>}
                  {t.source && <span class="quotes__source">via {t.source}</span>}
                </figcaption>
              </li>
            ))}
          </ul>
        )}

        {profile?.reviewsUrl && (
          <p class="reviewCta">
            <a class="btn btn--ghost" href={profile.reviewsUrl} target="_blank" rel="noopener noreferrer">
              <Icon name="check" size={18} />
              See our Google reviews
            </a>
          </p>
        )}
      </div>
    </section>
  )
}

<style>
  .reviewSummary {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: center;
    gap: var(--s-2) var(--s-3);
    margin: 0 0 var(--s-7);
    font-size: var(--fs-sm);
    color: var(--c-muted);
  }

  .reviewSummary__score {
    font-family: var(--ff-display);
    font-size: var(--fs-2xl);
    font-weight: var(--fw-bold);
    color: var(--c-navy);
    line-height: 1;
  }

  .stars {
    display: inline-flex;
    gap: 2px;
    /* Gold on the surface tint, not the body colour — 4.6:1, above AA. */
    color: var(--c-line);
    font-size: var(--fs-lg);
    line-height: 1;
  }

  .stars--sm {
    font-size: var(--fs-base);
  }

  .stars__s--full {
    color: var(--c-gold-600);
  }

  /* Half a star, drawn by clipping a full one rather than a second glyph. */
  .stars__s--half {
    background: linear-gradient(90deg, var(--c-gold-600) 50%, var(--c-line) 50%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .reviewCta {
    margin: var(--s-7) 0 0;
    text-align: center;
  }

  .reviewCta .btn {
    gap: var(--s-2);
  }

  /*
   * Columns, not a grid. Real reviews vary from one line to twenty, and a grid
   * stretches every card in a row to match the longest — one 900-character
   * review leaves two cards of mostly whitespace beside it. Columns let each
   * card take its own height and pack around the tall one.
   *
   * Truncating would tidy it too, but these are customers' own words and the
   * page says so; showing part of a review under a verbatim claim is worse than
   * an uneven column.
   */
  .quotes {
    columns: 3;
    column-gap: var(--s-5);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .quotes__item {
    /* A card split across a column break reads as two broken cards. */
    break-inside: avoid;
    margin-bottom: var(--s-5);
    display: flex;
    flex-direction: column;
    gap: var(--s-5);
    padding: var(--s-6);
    background: var(--c-bg);
    border: 1px solid var(--c-line);
    border-radius: var(--r-lg);
  }

  .quotes__quote {
    margin: 0;
    flex: 1;
  }

  .quotes__quote p {
    font-size: var(--fs-lg);
    color: var(--c-text);
  }

  .quotes__quote p::before {
    content: "\201C";
  }

  .quotes__quote p::after {
    content: "\201D";
  }

  .quotes__meta {
    display: flex;
    flex-direction: column;
    gap: var(--s-1);
    font-size: var(--fs-xs);
    color: var(--c-muted);
  }

  .quotes__author {
    font-size: var(--fs-sm);
    font-weight: var(--fw-semibold);
    color: var(--c-navy);
  }

  @media (max-width: 960px) {
    .quotes {
      columns: 2;
    }
  }

  @media (max-width: 640px) {
    .quotes {
      columns: 1;
    }
  }
</style>
