---
/**
 * StepsProcess — numbered process. Rendered as an ordered list so the sequence
 * is conveyed to screen readers by the markup, not only by the visual numbers.
 */
const { steps = [], heading, level = 2 } = Astro.props;
const Heading = `h${level}`;
---

{
  steps.length > 0 && (
    <div class="steps" data-reveal>
      {heading && <Heading class="steps__heading">{heading}</Heading>}
      <ol class="steps__list">
        {steps.map((s) => (
          <li class="steps__item">
            <h3 class="steps__title">{s.title}</h3>
            <p class="steps__body">{s.body}</p>
          </li>
        ))}
      </ol>
    </div>
  )
}

<style>
  .steps__heading {
    margin-bottom: var(--s-7);
  }

  .steps__list {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--s-5);
    margin: 0;
    padding: 0;
    counter-reset: step;
    list-style: none;
  }

  .steps__item {
    position: relative;
    counter-increment: step;
    padding-top: var(--s-7);
  }

  .steps__item::before {
    content: counter(step);
    position: absolute;
    top: 0;
    left: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: var(--r-pill);
    background: var(--c-navy);
    color: var(--c-on-dark);
    font-family: var(--font-heading);
    font-weight: var(--fw-bold);
    font-size: var(--fs-sm);
  }

  /* Connector line between steps, hidden on the last one and on small screens. */
  .steps__item::after {
    content: "";
    position: absolute;
    top: 19px;
    left: 44px;
    right: calc(var(--s-5) * -1 + 6px);
    height: 1px;
    background: var(--c-line);
  }

  .steps__item:last-child::after {
    display: none;
  }

  .steps__title {
    font-size: var(--fs-h4);
  }

  .steps__body {
    margin-top: var(--s-3);
    font-size: var(--fs-sm);
    color: var(--c-muted);
  }

  @media (max-width: 960px) {
    .steps__list {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--s-6);
    }
    .steps__item::after {
      display: none;
    }
  }

  @media (max-width: 600px) {
    .steps__list {
      grid-template-columns: 1fr;
    }
  }
</style>
