---
/**
 * CtaBand — closes every page. Rendered by BaseLayout, not by templates, so
 * no page can ship without a closing call to action.
 */
import { business, telHref, href } from "../lib/site.js";

const {
  heading = "Find out what solar would actually save you",
  body = "Send us your last bill and we'll come back with a system size, a price after rebates, and the assumptions behind both.",
  primaryLabel = "Get a Quote",
  primaryHref = "/quote/",
  showPhone = true,
} = Astro.props;
---

<section class="cta" data-reveal>
  <div class="container cta__inner">
    <div class="cta__text">
      <h2 class="cta__heading">{heading}</h2>
      <p class="cta__body">{body}</p>
    </div>
    <div class="cta__actions">
      <a class="btn btn--primary btn--lg" href={href(primaryHref)}>{primaryLabel}</a>
      {
        showPhone && (
          <a class="btn btn--on-dark btn--lg" href={telHref()}>
            Call {business.phoneDisplay}
          </a>
        )
      }
    </div>
  </div>
</section>

<style>
  .cta {
    background: var(--c-navy);
    color: var(--c-on-dark);
  }

  .cta__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-6);
    padding-block: var(--section-y-tight);
  }

  .cta__heading {
    color: var(--c-on-dark);
    font-size: var(--fs-h2);
  }

  .cta__body {
    margin-top: var(--s-3);
    max-width: 52ch;
    color: var(--c-on-dark-muted);
  }

  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
  }

  @media (max-width: 600px) {
    .cta__actions {
      width: 100%;
    }
    .cta__actions .btn {
      flex: 1 1 100%;
    }
  }
</style>
