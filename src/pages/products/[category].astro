---
/** Product category listing — one page per entry in PRODUCT_CATEGORIES. */
import BaseLayout from "../../layouts/BaseLayout.astro";
import InnerHero from "../../components/InnerHero.astro";
import SectionHeader from "../../components/SectionHeader.astro";
import FeatureCardGrid from "../../components/FeatureCardGrid.astro";
import LeadForm from "../../components/LeadForm.astro";
import BrandLogo from "../../components/BrandLogo.astro";
import { PRODUCT_CATEGORIES, business, services, href } from "../../lib/site.js";
import { brandsForCategory, getProductsByCategory, productPath } from "../../lib/catalogue.js";
import { breadcrumbSchema } from "../../lib/schema.js";

export function getStaticPaths() {
  return PRODUCT_CATEGORIES.map((category) => ({
    params: { category: category.slug },
    props: { category },
  }));
}

const { category } = Astro.props;

const categoryBrands = brandsForCategory(category.slug);
const categoryProducts = getProductsByCategory(category.slug);
const relatedService = services.find((s) => s.relatedBrandCategory === category.slug);

const crumbs = [
  { label: "Products", href: "/products/" },
  { label: category.title, href: `/products/${category.slug}/` },
];
---

<BaseLayout
  title={`${category.title} We Supply & Install | ${business.name}`}
  description={category.metaDescription}
  path={`/products/${category.slug}/`}
  schemas={[breadcrumbSchema(crumbs)]}
>
  <InnerHero
    kicker="Products"
    heading={category.title}
    body={category.summary}
    crumbs={crumbs}
    variant="compact"
    ctaLabel="Get a Quote"
    ctaHref="/quote/"
  />

  {
    categoryBrands.length > 0 ? (
      <section class="section">
        <div class="container">
          <SectionHeader
            heading={`${category.title} brands we install`}
            body={`${categoryProducts.length} models from ${categoryBrands.length} manufacturers. Each brand page lists its full range with specifications and documents.`}
            level={2}
          />
          <ul class="brandStrip" role="list">
            {categoryBrands.map((b, i) => (
              <li>
                <a class="brandStrip__link" href={href(`/brands/${b.slug}/#${category.slug}`)}>
                  <BrandLogo brand={b} priority={i < 8} decorative />
                  <span class="visually-hidden">
                    {b.name} — {b.productCount}{" "}
                    {b.productCount === 1 ? "product" : "products"}
                  </span>
                </a>
              </li>
            ))}
          </ul>
          <FeatureCardGrid
            items={categoryProducts.slice(0, 12).map((p) => ({
              title: `${p.brand} ${p.model}`,
              summary: [p.power_or_capacity, p.specs].filter(Boolean).join(" · "),
              meta: p.available ? undefined : "Temporarily unavailable",
              href: productPath(p),
            }))}
            columns={3}
            level={3}
          />
          {categoryProducts.length > 12 && (
            <p class="moreNote">
              Showing 12 of {categoryProducts.length}. The rest are listed on each brand's page
              above.
            </p>
          )}
        </div>
      </section>
    ) : (
      <section class="section">
        <div class="container container--narrow">
          <SectionHeader
            heading={`${category.title} options`}
            body={`We supply and install a range of ${category.title.toLowerCase()}. Product selection depends on your site, so rather than list brands here we recommend the right one after the assessment.`}
            level={2}
          />
        </div>
      </section>
    )
  }

  {
    relatedService && (
      <section class="section section--surface">
        <div class="container">
          <SectionHeader heading="The service behind these products" level={2} />
          <FeatureCardGrid
            items={[
              {
                title: relatedService.title,
                summary: relatedService.summary,
                icon: relatedService.icon,
                href: `/services/${relatedService.slug}/`,
              },
            ]}
            columns={2}
            level={3}
          />
        </div>
      </section>
    )
  }

  <section class="section section--alt">
    <div class="container container--narrow">
      <LeadForm
        id={`lead-${category.slug}`}
        heading={`Ask which ${category.title.toLowerCase().replace(/s$/, "")} suits your site`}
        body="Send your details and we'll recommend the right product for your roof and load — with the reasoning."
        source={`product:${category.slug}`}
      />
    </div>
  </section>
</BaseLayout>

<style>
  .brandStrip {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
    gap: var(--s-3);
    list-style: none;
    margin: var(--s-6) 0 var(--s-8);
    padding: 0;
  }

  .brandStrip__link {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 76px;
    padding: var(--s-3);
    border: 1px solid var(--c-line);
    border-radius: var(--r-md);
    background: var(--c-surface);
    text-decoration: none;
  }

  .brandStrip__link:hover,
  .brandStrip__link:focus-visible {
    border-color: var(--c-navy);
  }

  .moreNote {
    margin: var(--s-6) 0 0;
    font-size: var(--fs-sm);
    color: var(--c-muted);
  }
</style>
