---
/**
 * One page per brand.
 *
 * Data-driven from the distinct brands in catalogue.json, plus any brand that
 * only exists in brands.json — dropping those would 404 URLs the redirect map
 * already points at.
 */
import BrandTemplate from "../../templates/BrandTemplate.astro";
import { allBrandSlugs, getBrand } from "../../lib/catalogue.js";

export function getStaticPaths() {
  return allBrandSlugs.map((slug) => ({
    params: { brand: slug },
    props: { brand: getBrand(slug) },
  }));
}

const { brand } = Astro.props;
---

<BrandTemplate brand={brand} />
