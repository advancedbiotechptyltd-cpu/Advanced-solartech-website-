---
/**
 * BrandTemplate — one page per brand.
 *
 * Two kinds of brand share this layout. A handful have hand-written marketing
 * copy in brands.json, including the `considerations` section that keeps a
 * brand page from reading as pure promotion. The other forty-odd come from the
 * catalogue alone, and get a plain heading plus their product list.
 *
 * The marketing sections are conditional rather than filled in with something
 * plausible: writing strengths and trade-offs for a brand nobody here has a
 * view on would be inventing content, which is the one thing the content gate
 * exists to stop. A short honest page is fixable; a padded one is not.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import InnerHero from "../components/InnerHero.astro";
import SplitFeature from "../components/SplitFeature.astro";
import SectionHeader from "../components/SectionHeader.astro";
import KeyFacts from "../components/KeyFacts.astro";
import FeatureCardGrid from "../components/FeatureCardGrid.astro";
import LeadForm from "../components/LeadForm.astro";
import BrandLogo from "../components/BrandLogo.astro";
import { PRODUCT_CATEGORIES, business } from "../lib/site.js";
import {
  getProductsByBrand,
  brandProductGroups,
  productPath,
  categoryTitle,
  brandsForCategory,
} from "../lib/catalogue.js";
import { productSchema, breadcrumbSchema } from "../lib/schema.js";

const { brand } = Astro.props;

/** Hand-written copy, where it exists. Everything below degrades without it. */
const m = brand.marketing;

const category = PRODUCT_CATEGORIES.find((c) => c.slug === brand.category);

const items = getProductsByBrand(brand.slug);

/*
 * One section per category rather than one list. A brand selling inverters,
 * batteries and chargers otherwise interleaves them, and someone who arrived
 * from the inverter page lands on batteries.
 */
const groups = brandProductGroups(brand.slug).map((g) => ({
  ...g,
  cards: g.items.map((p) => ({
    title: p.model,
    summary: [p.power_or_capacity, p.specs].filter(Boolean).join(" · "),
    meta: p.available ? undefined : "Temporarily unavailable",
    href: productPath(p),
  })),
}));

const siblings = brandsForCategory(brand.category)
  .filter((b) => b.slug !== brand.slug)
  .slice(0, 6)
  .map((b) => ({
    title: b.name,
    summary:
      b.marketing?.summary ??
      `${b.productCount} ${b.productCount === 1 ? "product" : "products"} we supply and install.`,
    href: `/brands/${b.slug}/`,
  }));

const crumbs = [
  { label: "Products", href: "/products/" },
  { label: category?.title ?? "Products", href: `/products/${brand.category}/` },
  { label: brand.name, href: `/brands/${brand.slug}/` },
];

const categoriesLabel = brand.categorySlugs.map(categoryTitle).join(", ");

const keyFacts = [
  { label: "Category", value: categoriesLabel || category?.title || brand.category },
  m?.productTypes && { label: "Product types", value: m.productTypes.join(", ") },
  items.length > 0 && {
    label: "In our catalogue",
    value: `${items.length} ${items.length === 1 ? "model" : "models"}`,
  },
  { label: "Supplied and installed", value: "Yes" },
  { label: "Warranty", value: "Manufacturer terms — stated on your quote" },
].filter(Boolean);

/*
 * Forty-five brands sharing one template will collide on the duplicate title
 * and description checks unless each is genuinely distinct, so both fall back
 * to something built from that brand's own catalogue.
 */
const metaTitle = m?.metaTitle ?? `${brand.name} — Supplied & Installed | ${business.name}`;
const metaDescription =
  m?.metaDescription ??
  `${brand.name} ${categoriesLabel.toLowerCase()} supplied and installed by ${business.name}. ` +
    `${items.length} ${items.length === 1 ? "model" : "models"} in our catalogue, with datasheets and warranty documents.`;
const intro =
  m?.intro ??
  `We supply and install ${brand.name} ${categoriesLabel.toLowerCase()}. Every model we carry is listed below with its specification and, where the manufacturer publishes them, its datasheet, installation manual and warranty document.`;
const summary =
  m?.summary ?? `${brand.name} ${categoriesLabel.toLowerCase()}, supplied and installed across Victoria and New South Wales.`;
---

<BaseLayout
  title={metaTitle}
  description={metaDescription}
  path={`/brands/${brand.slug}/`}
  schemas={[productSchema({ ...brand, summary, productTypes: m?.productTypes }), breadcrumbSchema(crumbs)]}
>
  <InnerHero
    kicker={categoriesLabel}
    heading={`${brand.name} — supplied and installed`}
    body={summary}
    crumbs={crumbs}
    variant="compact"
    ctaLabel="Get a Quote"
    ctaHref="/quote/"
  />

  <section class="section">
    <div class="container">
      <SplitFeature heading={`About ${brand.name}`} body={intro} level={2}>
        <div slot="media" class="brandMedia">
          <BrandLogo brand={brand} priority class="brandMedia__logo" />
          <KeyFacts facts={keyFacts} level={2} />
        </div>
      </SplitFeature>
    </div>
  </section>

  {
    groups.length > 0 && (
      <section class="section section--surface">
        <div class="container">
          <SectionHeader
            kicker="Catalogue"
            heading={`${brand.name} models we supply`}
            body="Specifications and documents come from the manufacturer. Anything marked temporarily unavailable is not being ordered right now — ask and we will suggest an equivalent."
            level={2}
          />
          {groups.map((g) => (
            <div class="brandGroup" id={g.categorySlug}>
              <h3 class="brandGroup__heading">
                {brand.name} {g.noun}
                <span class="brandGroup__count">
                  {g.items.length} {g.items.length === 1 ? "model" : "models"}
                </span>
              </h3>
              <FeatureCardGrid items={g.cards} columns={3} level={4} />
            </div>
          ))}
        </div>
      </section>
    )
  }

  {m?.strengths?.length > 0 && (
  <section class="section">
    <div class="container">
      <div class="balance">
        <div class="balance__col">
          <SectionHeader heading={`Where ${brand.name} is the right choice`} level={2} />
          <ul class="balance__list" role="list">
            {m.strengths.map((s) => <li>{s}</li>)}
          </ul>
        </div>
        <div class="balance__col balance__col--caution">
          <SectionHeader heading="What to weigh up" level={2} />
          <p class="balance__body">{m.considerations}</p>
        </div>
      </div>
    </div>
  </section>
  )}

  <section class="section section--alt">
    <div class="container quoteRow">
      <SectionHeader
        kicker="Next step"
        heading={`Ask us whether ${brand.name} suits your roof`}
        body="Product choice should follow the site assessment, not lead it. Send us your details and we'll tell you what actually fits."
        level={2}
      />
      <LeadForm
        id={`lead-${brand.slug}`}
        heading="Request a quote"
        body="Two quick steps. We'll be in touch shortly."
        source={`brand:${brand.slug}`}
        compact
      />
    </div>
  </section>

  {
    siblings.length > 0 && (
      <section class="section">
        <div class="container">
          <SectionHeader heading={`Other ${(category?.title ?? "product").toLowerCase()} brands we install`} level={2} />
          <FeatureCardGrid items={siblings} columns={3} level={3} />
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  .brandGroup + .brandGroup {
    margin-top: var(--s-9);
  }

  .brandGroup__heading {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--s-3);
    margin: 0 0 var(--s-5);
    padding-bottom: var(--s-3);
    border-bottom: 1px solid var(--c-line);
    font-size: var(--fs-lg);
    color: var(--c-navy);
  }

  /* Scrolling to #inverters must not tuck the heading under the sticky header. */
  .brandGroup {
    scroll-margin-top: calc(var(--header-h) + var(--s-6));
  }

  .brandGroup__count {
    font-family: var(--ff-body);
    font-size: var(--fs-sm);
    font-weight: var(--fw-regular);
    color: var(--c-muted);
  }

  .brandMedia {
    display: flex;
    flex-direction: column;
    gap: var(--s-5);
  }

  .brandMedia__logo {
    height: 60px;
    padding: var(--s-5);
    border: 1px solid var(--c-line);
    border-radius: var(--r-md);
    background: var(--c-surface);
  }

  .balance {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(var(--s-6), 5vw, var(--s-9));
  }

  .balance__list {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    margin: 0;
    padding-left: var(--s-5);
  }

  .balance__list li {
    font-size: var(--fs-lg);
  }

  .balance__col--caution {
    padding: var(--s-6);
    background: var(--c-bg);
    border-radius: var(--r-lg);
    border-left: 3px solid var(--c-gold);
  }

  .balance__body {
    font-size: var(--fs-lg);
    color: var(--c-muted);
  }

  .quoteRow {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(var(--s-6), 5vw, var(--s-9));
    align-items: start;
  }

  @media (max-width: 960px) {
    .balance,
    .quoteRow {
      grid-template-columns: 1fr;
    }
  }
</style>
