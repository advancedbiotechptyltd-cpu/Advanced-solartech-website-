node_modules
dist/
.astro/
.env
.env.production
.DS_Store

# Staging upload artifact — rebuilt by `npm run build:staging`.
*.zip

# Generated worklist — rebuilt by `npm run gaps`.
catalogue-gaps.csv

# Hand-off copies of build output, made when sending files to whoever does the
# cPanel upload. Generated from src/data/redirects.json by the build — a copy
# committed here would drift from that source and go stale without anyone
# noticing.
redirects-for-*.conf

# The PRIVATE supplier catalogue — see docs/README.md.
#
# Supplier lines with a price column: the commercial core of the business, and
# this repository is public. It needs its own private repo and a backend that
# can authenticate staff.
#
# Not to be confused with src/data/catalogue.json, which is the PUBLIC product
# catalogue — brand, model, specs and manufacturer document links, no supplier
# codes and no prices. That one is the source of the /products pages and is
# committed on purpose, so it is un-ignored below.
catalogue*.json
catalogue*.csv
catalogue*.xlsx
catalogue-seed.*
products-by-supplier.*
!src/data/catalogue.json
